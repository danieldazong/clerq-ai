# LLM API Credentials
# Used for the Information Extractor node
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Configuration (If managing credentials via env vars)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# n8n Webhook Configuration
# Base URL for the Manager Approval email callbacks
N8N_WEBHOOK_URL=https://your-n8n-instance-url.com/webhook/