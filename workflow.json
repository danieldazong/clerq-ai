    {
      "parameters": {
        "jsCode": "const extraction = $(\"Information Extractor\").first().json.output;\nconst existingRows = $(\"Get row(s) in sheet\").all();\n\n// 1. Check for Duplicate (Accounts for the empty placeholder from \"Always Output Data\")\nconst isDuplicate = existingRows.length > 0 && Object.keys(existingRows[0].json).length > 0;\n\n// 2. Validate Required Fields & Amounts\nconst hasRequiredFields = \n  Boolean(extraction.vendor_name) && \n  Boolean(extraction.invoice_number) && \n  Boolean(extraction.due_date) && \n  typeof extraction.total_amount === 'number' && \n  extraction.total_amount > 0;\n\nlet status = \"VALID\";\nlet failureReason = null;\n\nif (isDuplicate) {\n  status = \"DUPLICATE_REJECTED\";\n  failureReason = \"Invoice already recorded in audit log.\";\n} else if (!hasRequiredFields) {\n  status = \"NEEDS_HUMAN_REVIEW\";\n  failureReason = \"Missing required invoice fields or invalid total amount.\";\n}\n\nreturn {\n  json: {\n    ...extraction,\n    validation_status: status,\n    failure_reason: failureReason,\n    requires_approval: status === \"VALID\" && extraction.total_amount > 1000\n  }\n};"
      },
