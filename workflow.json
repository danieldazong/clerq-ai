    {
      "parameters": {
        "jsCode": "const newItems = [];\n\nfor (const item of $input.all()) {\n  if (!item.binary) continue;\n  \n  // Loop through attachment_0, attachment_1, etc.\n  for (const key of Object.keys(item.binary)) {\n    const file = item.binary[key];\n    \n    // 1. Ensure the file is a PDF\n    const isPDF = file.mimeType === 'application/pdf';\n    \n    // 2. Ensure the file name does NOT contain the word \"receipt\"\n    const fileName = (file.fileName || \"\").toLowerCase();\n    const isNotReceipt = !fileName.includes('receipt');\n    \n    // Only pass the file forward if it passes both tests\n    if (isPDF && isNotReceipt) {\n      newItems.push({\n        json: {\n          ...item.json,\n          source_email_subject: item.json.subject,\n          original_attachment_key: key,\n          processed_filename: file.fileName\n        },\n        binary: {\n          data: file // Standardizes the name to 'data'\n        }\n      });\n    }\n  }\n}\n\nreturn newItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
